parameters:
    level: 9
    paths:
        - src
        - tests
    tmpDir: build/phpstan
    ignoreErrors:
        -
            identifier: method.notFound
            path: tests/ArchTest.php
        -
            identifier: method.notFound
            path: tests/TypesenseCheckTest.php
        -
            identifier: assign.propertyType
            path: tests/TypesenseCheckTest.php
