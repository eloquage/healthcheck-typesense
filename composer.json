{
    "name": "illuma-law/healthcheck-typesense",
    "description": "A Typesense health check for Spatie's Laravel Health package.",
    "keywords": [
        "illuma-law",
        "laravel",
        "health",
        "healthcheck",
        "typesense"
    ],
    "homepage": "https://github.com/illuma-law/healthcheck-typesense",
    "license": "MIT",
    "authors": [
        {
            "name": "illuma-law",
            "email": "support@illuma.law",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "spatie/laravel-health": "^1.39",
        "typesense/typesense-php": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "nunomaduro/collision": "^8.6",
        "larastan/larastan": "^3.1",
        "orchestra/testbench": "^10.1",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.39"
    },
    "autoload": {
        "psr-4": {
            "IllumaLaw\\HealthCheckTypesense\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IllumaLaw\\HealthCheckTypesense\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IllumaLaw\\HealthCheckTypesense\\HealthCheckTypesenseServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
